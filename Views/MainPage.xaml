<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:viewmodels="clr-namespace:AppTickets.ViewModels"
             xmlns:models="clr-namespace:AppTickets.Models"
             x:Class="AppTickets.Views.MainPage"
             Title="Dashboard de Tickets"
             BackgroundColor="#F3F4F6">

    <ScrollView>
        <Grid RowDefinitions="Auto, *, Auto" Padding="20" RowSpacing="20">
            
            <VerticalStackLayout Grid.Row="0" Spacing="4">
                <Label Text="Sistema de Soporte" FontSize="14" TextColor="#4B5563" FontAttributes="Bold"/>
                <Label Text="Control de Solicitudes" FontSize="26" FontAttributes="Bold" TextColor="#111827" />
                <BoxView HeightRequest="2" BackgroundColor="#2563EB" HorizontalOptions="Start" WidthRequest="60" Margin="0,5,0,0"/>
            </VerticalStackLayout>

            <VerticalStackLayout Grid.Row="1" Spacing="10">
                <Label Text="Tickets en el Sistema" FontSize="16" FontAttributes="Bold" TextColor="#374151" Margin="0,10,0,5"/>
                
                <CollectionView ItemsSource="{Binding ListaTickets}">
                    <CollectionView.ItemTemplate>
                        <DataTemplate x:DataType="models:Ticket">
                            <Border StrokeShape="RoundRectangle 8" Margin="0,0,0,12" Padding="15" BackgroundColor="White" Stroke="#E5E7EB">
                                <Grid ColumnDefinitions="*, Auto" RowDefinitions="Auto, Auto, Auto">
                                    
                                    <VerticalStackLayout Grid.Column="0" Grid.Row="0" Spacing="4" VerticalOptions="Center">
                                        <HorizontalStackLayout Spacing="8" VerticalOptions="Center">
                                            <Border BackgroundColor="#EFF6FF" StrokeShape="RoundRectangle 4" Padding="6,2">
                                                <Label Text="{Binding Id, StringFormat='#{0}'}" FontAttributes="Bold" FontSize="12" TextColor="#2563EB"/>
                                            </Border>
                                            <Label Text="{Binding Titulo}" FontAttributes="Bold" FontSize="16" TextColor="#111827" VerticalOptions="Center"/>
                                        </HorizontalStackLayout>
                                        
                                        <Label Text="{Binding Descripcion}" TextColor="#4B5563" FontSize="14" Margin="0,4,0,4" />
                                        
                                        <HorizontalStackLayout Spacing="10" Margin="0,2,0,0">
                                            <Label Text="{Binding Prioridad, StringFormat='Prioridad: {0}'}" FontSize="12" TextColor="#D97706" FontAttributes="Bold"/>
                                            <Label Text="•" TextColor="#9CA3AF"/>
                                            <Label Text="{Binding Estado, StringFormat='Estado: {0}'}" FontSize="12" TextColor="#2563EB" FontAttributes="Bold"/>
                                        </HorizontalStackLayout>
                                    </VerticalStackLayout>

                                    <VerticalStackLayout Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="2" Margin="0,8,0,0" Spacing="2">
                                        <BoxView HeightRequest="1" BackgroundColor="#F3F4F6" Margin="0,0,0,4"/>
                                        <Label Text="{Binding FechaCreacion, StringFormat='Creado: {0:g}'}" FontSize="11" TextColor="#9CA3AF" />
                                        <Label Text="{Binding FechaUltimoCambioEstado, StringFormat='Última Modificación: {0:g}'}" FontSize="11" TextColor="#6B7280" />
                                    </VerticalStackLayout>

                                    <Button Grid.Column="1" Grid.Row="0"
                                            Text="Avanzar"
                                            FontSize="12"
                                            FontAttributes="Bold"
                                            HeightRequest="40"
                                            Padding="15,0"
                                            VerticalOptions="Center"
                                            BackgroundColor="#10B981"
                                            TextColor="White"
                                            Command="{Binding BindingContext.AvanzarEstadoCommand, Source={RelativeSource AncestorType={x:Type viewmodels:TicketsViewModel}}}"
                                            CommandParameter="{Binding .}" />
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </CollectionView.ItemTemplate>
                </CollectionView>
            </VerticalStackLayout>

            <Border Grid.Row="2" 
                    StrokeShape="RoundRectangle 12" 
                    Padding="20" 
                    BackgroundColor="White" 
                    Stroke="#E5E7EB" 
                    MaximumWidthRequest="600"
                    HorizontalOptions="CenterAndExpand"
                    Margin="0,10,0,0">
                <VerticalStackLayout Spacing="12">
                    <Label Text="Registrar Nuevo Ticket" FontSize="18" FontAttributes="Bold" TextColor="#111827" Margin="0,0,0,5"/>
                    
                    <VerticalStackLayout Spacing="4">
                        <Label Text="Título del Problema" FontSize="12" FontAttributes="Bold" TextColor="#4B5563"/>
                        <Entry Placeholder="Ej. Error al conectar Base de Datos" BackgroundColor="#F9FAFB" TextColor="#111827"/>
                    </VerticalStackLayout>

                    <VerticalStackLayout Spacing="4">
                        <Label Text="Descripción Detallada" FontSize="12" FontAttributes="Bold" TextColor="#4B5563"/>
                        <Editor Placeholder="Escriba los detalles del error aquí..." HeightRequest="70" BackgroundColor="#F9FAFB" TextColor="#111827"/>
                    </VerticalStackLayout>

                    <VerticalStackLayout Spacing="4">
                        <Label Text="Prioridad" FontSize="12" FontAttributes="Bold" TextColor="#4B5563"/>
                        <Picker Title="Seleccione la prioridad" BackgroundColor="#F9FAFB">
                            <Picker.ItemsSource>
                                <x:Array Type="{x:Type x:String}">
                                    <x:String>Alta</x:String>
                                    <x:String>Media</x:String>
                                    <x:String>Baja</x:String>
                                </x:Array>
                            </Picker.ItemsSource>
                        </Picker>
                    </VerticalStackLayout>

                    <Button Text="Guardar Ticket" 
                            BackgroundColor="#2563EB" 
                            TextColor="White" 
                            FontAttributes="Bold"
                            HeightRequest="45"
                            WidthRequest="220"
                            HorizontalOptions="Center"
                            Margin="0,10,0,0"/>
                </VerticalStackLayout>
            </Border>

        </Grid>
    </ScrollView>
</ContentPage>
